# Created automatically by ./run.sh on first launch.
# To configure manually: cp .env.example .env, then edit it.
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# fixed = only TELEGRAM_USER_ID may use the bot (recommended).
# first = whoever sends /start first becomes the owner.
OWNER_MODE=fixed
TELEGRAM_USER_ID=123456789

# Optional settings (uncomment to customize):
# WHISPER_MODEL=/home/youruser/.local/share/whisper/models/ggml-small.bin
# WHISPER_LANGUAGE=auto
# WHISPER_THREADS=8
# AUDIO_DIR=/home/youruser/Downloads/audiofiles
